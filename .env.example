# Copy to .env (gitignored) and fill in. Never commit real values.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DASHBOARD_ORIGINS=http://localhost:3001

# PostgreSQL 16. Use the compose service name `postgres` when running in Docker.
DATABASE_URL=postgres://cardcrypto:CHANGE_ME@localhost:5432/cardcrypto

# Generate each secret with: openssl rand -hex 32   (at least 32 characters)
JWT_SECRET=
API_KEY_PEPPER=
# 32 random bytes, base64: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Live mode stays off until compliance, processor and treasury are in place (docs/DEPLOYMENT.md).
LIVE_MODE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RPC_URLS_ETHEREUM=
RPC_URLS_POLYGON=
RPC_URLS_BASE=
RPC_URLS_ARBITRUM=
# Development only. Production requires a KMS/HSM-backed signer (see docs/DEPLOYMENT.md).
TREASURY_PRIVATE_KEY=
UNSAFE_ALLOW_ENV_SIGNER=false
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Fee policy (basis points of the gross amount; payment fee is an estimate of the acquirer's cost)
FEE_PAYMENT_BPS=150
FEE_PAYMENT_FIXED_MINOR=25
FEE_CONVERSION_BPS=50
FEE_PLATFORM_BPS=50

# Settlement protection
WALLET_ACTIVATION_DELAY_HOURS=24
REQUIRE_MFA_FOR_LIVE=true
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
CHECKOUT_TTL_MINUTES=30
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
LOG_LEVEL=info
