{
  "name": "cardcrypto-shopify-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "MVP Shopify app that creates Card-to-Crypto payments for Shopify orders",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
