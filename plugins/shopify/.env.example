# Copy to .env (never commit .env). Values below are placeholders.

# Public base URL of this app (https in production; http://localhost:3000 for local dev).
APP_URL=https://shopify.example.com
PORT=3000

# PostgreSQL (dedicated database, e.g. cardcrypto_shopify).
DATABASE_URL=postgres://cardcrypto:CHANGE_ME@127.0.0.1:5432/cardcrypto_shopify

# Shopify Partner app credentials (Client ID / Client secret).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Must be exactly the scopes requested in shopify.app / Partner dashboard.
SHOPIFY_SCOPES=read_orders,write_orders
# Admin GraphQL API version (see README: verify against the Shopify versioning page).
SHOPIFY_API_VERSION=2026-10
SHOPIFY_TIMEOUT_MS=8000

# 32 random bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# At least 32 random characters. Signs the OAuth state cookie.
COOKIE_SECRET=

# Card-to-Crypto backend. Use a sk_test_ key for test mode.
CARDCRYPTO_API_BASE_URL=http://localhost:4000
CARDCRYPTO_API_KEY=sk_test_0000000000000000_REPLACE_WITH_43_CHAR_SECRET_VALUE_xxxxx
# Signing secret of the webhook endpoint that points at /webhooks/cardcrypto.
CARDCRYPTO_WEBHOOK_SECRET=
CARDCRYPTO_TIMEOUT_MS=4000

WEBHOOK_CLAIM_TTL_SECONDS=300
